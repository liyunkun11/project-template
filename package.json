{
  "name": "project-template",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "svgo:simple": "svgo -f src/icons/simple --config=src/icons/svgo.config.cjs",
    "svgo:complex": "svgo -f src/icons/complex --config=src/icons/svgo.config.cjs"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.16.0",
    "color": "^5.0.3",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "lodash-es": "^4.18.1",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.34",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.7",
    "vue3-colorpicker": "^2.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.12.3",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-plugin-format": "^2.0.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "less": "^4.6.4",
    "lint-staged": "^16.4.0",
    "typescript": "~6.0.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.12",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.2.8"
  },
  "lint-staged": {
    "*.{js,cjs,ts,vue}": [
      "eslint --fix"
    ]
  }
}
